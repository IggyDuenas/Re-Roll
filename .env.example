# Public base URL used in SMS links (defaults to the request origin)
APP_URL=http://localhost:3000
# Timezone used to display event times
APP_TIMEZONE=America/New_York

# Marketplace rules
MAX_MARKUP_PCT=150      # max asking price as % of face value (150 = 1.5x)
PLATFORM_FEE_PCT=10     # Re-Roll's cut of each sale, deducted from the seller's payout
RESERVE_MINUTES=15      # how long a buyer has to pay after reserving

# Secrets for the operator endpoints (disabled while unset)
CRON_SECRET=            # POST /api/cron/settle with "Authorization: Bearer <secret>"
ADMIN_SECRET=           # POST /api/admin/orders/<id> with "Authorization: Bearer <secret>"

# Supabase store: when BOTH are set the app uses Supabase instead of .data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS: when all three are set messages are texted; otherwise they print to the server console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100

# Override the local JSON file location (default .data/db.json)
# LOCAL_DB_PATH=.data/db.json
