# Public base URL used in ticket links sent by SMS (defaults to the request origin)
APP_URL=http://localhost:3000
# Timezone used to display event times
APP_TIMEZONE=America/New_York

# Supabase store: when BOTH are set the app uses Supabase instead of .data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS: when all three are set tickets are texted; otherwise the link is printed to the server console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15555550100

# Override the local JSON file location (default .data/db.json)
# LOCAL_DB_PATH=.data/db.json
